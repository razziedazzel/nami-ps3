diff --git a/scripts/002-gcc-newlib-PPU.sh b/scripts/002-gcc-newlib-PPU.sh
index b6166ec..5b85ea2 100755
--- a/scripts/002-gcc-newlib-PPU.sh
+++ b/scripts/002-gcc-newlib-PPU.sh
@@ -35,6 +35,9 @@ if [ ! -d ${GCC} ]; then
   ## Patch the source code.
   cat ../patches/${GCC}-PS3.patch | patch -p1 -d ${GCC}
 
+  ## Host libstdc++ 16: include these before safe-ctype.h defines its ctype macros.
+  sed -i '/^#include "safe-ctype.h"/i #ifdef __cplusplus\n# include <memory>\n# include <mutex>\n# include <sstream>\n#endif' ${GCC}/gcc/system.h
+
   ## Replace config.guess and config.sub
   cp ../archives/config.guess ../archives/config.sub ${GCC}
 
